# RoadRescue Frontend Environment Variables (Vite)
# In development, leave blank to use the Vite dev server proxy configured in vite.config.js
# In production on Vercel, set these to your backend Render URL (e.g. https://roadrescue-api.onrender.com)

# Backend REST API Base URL (optional in dev, required in production if not reverse-proxied)
VITE_API_URL=https://your-backend-api.onrender.com/api

# Backend Socket.IO Server URL (optional in dev, required in production)
VITE_SOCKET_URL=https://your-backend-api.onrender.com
